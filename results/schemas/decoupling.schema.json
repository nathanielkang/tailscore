{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "decoupling/v1",
  "title": "TailScore Decoupling Analysis (Clause 3)",
  "description": "Output of scripts/analyze_decoupling.py — partial correlation gate.",
  "type": "object",
  "required": ["schema", "created_at", "gate", "datasets"],
  "properties": {
    "schema": { "type": "string", "const": "decoupling/v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "config": { "type": "string" },
    "T": { "type": "integer" },
    "k_neighbors": { "type": "integer" },
    "n_samples_per_ds": { "type": "integer" },
    "seeds": { "type": "array", "items": { "type": "integer" } },
    "elapsed_sec": { "type": "number" },
    "gate": {
      "type": "object",
      "required": ["clause_3_pass", "threshold_median", "threshold_p75"],
      "properties": {
        "n_valid": { "type": "integer" },
        "n_total": { "type": "integer" },
        "median_abs_rho": { "type": ["number", "null"] },
        "p75_abs_rho": { "type": ["number", "null"] },
        "median_abs_partial_rho": { "type": ["number", "null"] },
        "p75_abs_partial_rho": { "type": ["number", "null"] },
        "max_abs_partial_rho": { "type": ["number", "null"] },
        "mean_abs_partial_rho": { "type": ["number", "null"] },
        "threshold_median": { "type": "number", "const": 0.20 },
        "threshold_p75":    { "type": "number", "const": 0.30 },
        "clause_3_pass": { "type": ["boolean", "string"] },
        "failure_reason": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "seed"],
        "properties": {
          "name": { "type": "string" },
          "dependency": { "type": "string" },
          "tail_severity": { "type": "string" },
          "cat_complexity": { "type": "string" },
          "seed": { "type": "integer" },
          "n_train": { "type": "integer" },
          "partial_rho": { "type": ["number", "null"] },
          "abs_partial_rho": { "type": ["number", "null"] },
          "error": { "type": "string" }
        }
      }
    }
  }
}
