{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pilot_r6_summary/v1",
  "title": "TailScore R6 Pilot Summary",
  "description": "Output of scripts/run_pilot.py — Clause 4 real-data gate + references to Clauses 1-3.",
  "type": "object",
  "required": ["schema", "created_at", "clause_4", "overall_verdict", "runs"],
  "properties": {
    "schema": { "type": "string", "const": "pilot_r6_summary/v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "config": { "type": "string" },
    "corruption": {
      "type": "object",
      "properties": {
        "train": { "type": "string" },
        "eval": { "type": "string" }
      }
    },
    "score_partition_ratio": { "type": "number" },
    "T": { "type": "integer" },
    "n_runs": { "type": "integer" },
    "elapsed_sec": { "type": "number" },
    "mean_tail_mae_gain_vs_tong": { "type": ["number", "null"] },
    "clause_4": {
      "type": "object",
      "required": ["clause_4_pass", "n_wins", "min_wins_required"],
      "properties": {
        "clause_4_pass": { "type": "boolean" },
        "n_wins": { "type": "integer" },
        "n_datasets_evaluated": { "type": "integer" },
        "min_wins_required": { "type": "integer" },
        "win_target": { "type": "string" },
        "dataset_verdicts": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "pilot_gate_checks": {
      "type": "object",
      "properties": {
        "spearman_gate": {
          "type": "object",
          "properties": {
            "median_spearman": { "type": "number" },
            "threshold": { "type": "number" },
            "pass": { "type": "boolean" }
          }
        },
        "n_tail_check": { "type": "object" }
      }
    },
    "overall_verdict": {
      "type": "object",
      "properties": {
        "clause_4_pass": { "type": "boolean" },
        "clauses_1_2_3_source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset": { "type": "string" },
          "seed": { "type": "integer" },
          "T": { "type": "integer" },
          "stage": { "type": "string" },
          "spearman": { "type": "number" },
          "tail_mae": { "type": "number" },
          "fds_tail_mae": { "type": "number" },
          "tong_tail_mae": { "type": "number" },
          "win_vs_tong": { "type": "boolean" },
          "tail_mae_gain_vs_tong": { "type": "number" },
          "error": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
