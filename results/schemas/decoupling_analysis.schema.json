{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tailscore/decoupling_analysis.schema.json",
  "title": "TailScore Clause-3 decoupling analysis result",
  "description": "Output of scripts/analyze_decoupling.py — partial rho gate",
  "type": "object",
  "required": [
    "schema",
    "seeds",
    "n_runs",
    "aggregate",
    "datasets"
  ],
  "properties": {
    "schema": { "type": "string", "enum": ["decoupling_analysis/v1"] },
    "created_at": { "type": "string" },
    "config": { "type": "string" },
    "n_samples_per_ds": { "type": "integer" },
    "T": { "type": "integer" },
    "score_partition_ratio": { "type": "number" },
    "seeds": { "type": "array", "items": { "type": "integer" } },
    "n_runs": { "type": "integer" },
    "elapsed_sec": { "type": "number" },
    "aggregate": {
      "type": "object",
      "required": ["clause_3_pass", "threshold_median", "threshold_p75"],
      "properties": {
        "n_valid": { "type": "integer" },
        "median_abs_partial_rho": { "type": ["number", "null"] },
        "p75_abs_partial_rho": { "type": ["number", "null"] },
        "max_abs_partial_rho": { "type": ["number", "null"] },
        "mean_abs_partial_rho": { "type": ["number", "null"] },
        "threshold_median": { "type": "number" },
        "threshold_p75": { "type": "number" },
        "clause_3_pass": { "type": "boolean" },
        "fail_reason": { "type": ["string", "null"] },
        "note": { "type": "string" }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "dependency": { "type": "string" },
          "tail_severity": { "type": "string" },
          "cat_complexity": { "type": "string" },
          "seed": { "type": "integer" },
          "n_train": { "type": "integer" },
          "partial_rho": { "type": ["number", "null"] },
          "abs_partial_rho": { "type": ["number", "null"] },
          "raw_spearman_rho": { "type": ["number", "null"] },
          "error": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
